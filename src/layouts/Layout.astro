---
import '../styles/global.css';
import serifFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import italicFont from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-italic.woff2?url';
import sansFont from '@fontsource/dm-sans/files/dm-sans-latin-400-normal.woff2?url';
interface Props { title?: string; description?: string; }
const {title='Six Senses Ibiza — The Beauty of Being',description='An independent design study inspired by the quiet northern coast of Ibiza. Discover suites, wellness, Mediterranean dining and a slower rhythm of life. Not affiliated with Six Senses.'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site).href;
const base = import.meta.env.BASE_URL;
const socialImage = new URL(`${base}social/hero-preview-v1.jpg`, Astro.site).href;
const socialImageAlt = 'Six Senses Ibiza portfolio concept: the complete Hero with resort photography, navigation, THE BEAUTY OF BEING headline and Explore the Resort action.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#F7F5F0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={italicFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="A Mediterranean escape. An independent portfolio concept, not affiliated with Six Senses. Illustrative photography." />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script src="../scripts/main.ts"></script>
  </body>
</html>
