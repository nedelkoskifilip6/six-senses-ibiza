---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import HeroPhoto from '../components/HeroPhoto.astro';
import Sun from '../components/Sun.astro';
import StayGallery from '../components/StayGallery';
import PhotoLightbox from '../components/PhotoLightbox';
import { rooms } from '../data/content';
const base = import.meta.env.BASE_URL;
const official = 'https://www.sixsenses.com/en/hotels-resorts/europe/spain/ibiza/';
const nav = [['Discover','discover'],['Stay','stay'],['Wellness','wellness'],['Dining','dining'],['Experiences','experiences'],['Gallery','gallery']];
const gallery = [
  {image:'hero',caption:'The water, the light',location:'IBIZA · DESTINATION PHOTOGRAPHY'},
  {image:'suite',caption:'Softness in the details',location:'TUNISIA · ILLUSTRATIVE INTERIOR'},
  {image:'coast',caption:'Along the quiet coast',location:'IBIZA · ILLUSTRATIVE RESORT'},
  {image:'spa',caption:'A moment, entirely yours',location:'ILLUSTRATIVE WELLNESS INTERIOR'},
  {image:'dining',caption:'An invitation to linger',location:'SPAIN · ILLUSTRATIVE DINING'},
  {image:'sunset',caption:'Nothing more to do',location:'ES VEDRÀ, IBIZA'}
];
---
<Layout>
  <header class="site-header" id="site-header">
    <a href="#" class="wordmark" aria-label="Six Senses Ibiza concept, back to top"><span class="wordmark-name">six senses<span class="wordmark-orbit" aria-hidden="true">◌</span></span><span class="wordmark-place">IBIZA / AN INDEPENDENT STUDY</span></a>
    <nav class="desktop-nav" aria-label="Main navigation">{nav.map(([name,id]) => <a href={`#${id}`}>{name}</a>)}</nav>
    <a class="nav-book" href="#reservation">Book your stay</a>
    <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span></button>
  </header>
  <dialog class="mobile-menu" id="mobile-menu" aria-label="Navigation">
    <div class="menu-top"><span class="eyebrow">THE BEAUTY OF BEING HERE.</span><button class="menu-close" aria-label="Close menu">Close <span aria-hidden="true">×</span></button></div>
    <nav aria-label="Mobile navigation">{nav.map(([name,id],i) => <a href={`#${id}`}><span class="menu-number">0{i+1}</span>{name}</a>)}</nav>
    <a href="#reservation" class="text-link menu-reserve">Book your stay</a>
    <p>Independent Portfolio Concept — Not affiliated with Six Senses.</p>
  </dialog>
  <main id="main">
    <section class="hero-story" aria-labelledby="hero-title">
      <div class="hero-stage">
        <div class="hero-photo-frame"><HeroPhoto /><div class="hero-shade"></div></div>
        <div class="hero-content">
          <div class="hero-kicker"><span>39° NORTH. A WORLD APART.</span><span>IBIZA, BALEARIC ISLANDS</span></div>
          <h1 id="hero-title"><span class="hero-line">THE BEAUTY</span><span class="hero-line hero-line-second">OF <em>BEING.</em></span></h1>
          <div class="hero-bottom"><p>Discover a world where nature, architecture,<br class="desktop-only" /> and extraordinary living exist in perfect harmony.</p><a href="#discover" class="hero-explore">Explore the Resort</a></div>
        </div>
        <div class="hero-foot"><span>THE MEDITERRANEAN, AT YOUR OWN PACE.</span><span>INDEPENDENT PORTFOLIO CONCEPT</span></div>
        <span class="hero-photo-note">Independent portfolio concept · Hero photography supplied for this study</span>
        <figure class="frame-secondary" aria-hidden="true"><Photo image="hero" alt="" sizes="35vw" /><figcaption>01 — A DIFFERENT PERSPECTIVE</figcaption></figure>
        <div class="transition-copy" aria-hidden="true"><span class="eyebrow">AN ISLAND WITHIN THE ISLAND</span><p>Where time<br />stands <em>still.</em></p><span class="transition-coordinate">NATURE. SPACE. A SENSE OF BELONGING.</span></div>
      </div>
    </section>
    <section class="sanctuary section-pad" id="discover" aria-labelledby="sanctuary-title">
      <div class="section-marker"><span>01 — THE SANCTUARY</span><span>THE QUIET NORTH OF IBIZA</span></div>
      <div class="sanctuary-heading"><span class="eyebrow">A DIFFERENT RHYTHM OF LIFE</span><h2 class="display reveal" id="sanctuary-title">WHERE TIME<br /><span>STANDS <em>STILL.</em></span></h2><Sun /></div>
      <div class="sanctuary-grid">
        <figure class="sanctuary-visual reveal-image"><Photo image="hero" alt="Sunlit turquoise water and small boats in an Ibiza cove; destination photography" class="parallax-photo" /><figcaption><span>THE ISLAND, SEEN DIFFERENTLY.</span><span>IBIZA / SPAIN</span></figcaption></figure>
        <div class="sanctuary-copy"><p class="lead reveal">Some places ask you<br />to do more.<br /><em>This one invites you to be.</em></p><p class="reveal">At Cala Xarraca, on Ibiza’s northern coast, pine-covered hills meet the open Mediterranean. Light moves across stone. The sea becomes your measure of time.</p><p class="reveal">Six Senses Ibiza brings a thoughtful approach to this landscape: spaces for gathering, rituals of wellbeing, and a closer connection to the island.</p><a class="text-link" href={`${official}destination/`} target="_blank" rel="noopener noreferrer">Meet the other Ibiza</a><div class="sanctuary-aside"><span>THE LUXURY OF</span><em>less.</em></div></div>
      </div>
    </section>
    <section class="stays section-pad" id="stay" aria-labelledby="stay-title">
      <div class="section-marker"><span>02 — THE RESIDENCES</span><span>SPACES WITH A SOUL</span></div>
      <div class="stay-heading"><h2 class="display reveal" id="stay-title">A place to<br /><em>call your own.</em></h2><p class="section-intro reveal">Sea-facing suites. Private terraces. Space to come together, or simply disappear for a while. Find your own way of being here.</p></div>
      <StayGallery rooms={rooms} imageBase={`${base}images/`} client:load />
    </section>
    <section class="living-story" aria-labelledby="living-title"><div class="living-frame"><Photo image="terrace" alt="Sculptural white terrace above the Aegean at sunset; illustrative Mediterranean architecture, Greece" sizes="100vw" /><div class="living-caption"><span class="eyebrow">AN OPEN INVITATION</span><h2 id="living-title">Inside.<br />Outside.<br /><em>In harmony.</em></h2><span class="living-note">MEDITERRANEAN ARCHITECTURE STUDY · GREECE</span></div></div><div class="living-foot"><p>A terrace. A horizon.<br /><em>Everything you need.</em></p><a class="text-link" href="#stay">Explore the spaces</a></div></section>
    <section class="wellness section-pad" id="wellness" aria-labelledby="wellness-title">
      <div class="section-marker"><span>03 — THE ART OF WELLBEING</span><span>LESS NOISE. MORE YOU.</span></div>
      <div class="wellness-heading"><h2 class="display reveal" id="wellness-title">A return to<br /><em>your natural self.</em></h2><span class="wellness-breathe"><Sun /><span>INHALE. EXHALE. REPEAT.</span></span></div>
      <div class="wellness-composition"><div class="wellness-copy"><span class="eyebrow">RESTORE YOUR NATURAL BALANCE</span><p class="lead reveal">The art of<br /><em>doing a little less.</em></p><p>From the seafront yoga deck to the hammam, Six Senses Spa makes space for movement, rest, and a return to your own rhythm.</p><div class="wellness-rituals"><span><i>01</i> Yoga & meditation</span><span><i>02</i> Personalized wellness</span><span><i>03</i> Hammam & spa rituals</span></div><a class="text-link" href={`${official}wellness-spa/`} target="_blank" rel="noopener noreferrer">The art of feeling well</a></div><figure class="wellness-visual reveal-image"><Photo image="spa" alt="Sculpted plaster treatment room in warm natural light; illustrative spa interior" /><figcaption>STILLNESS, BEAUTIFULLY PRACTICED. / ILLUSTRATIVE INTERIOR</figcaption></figure><span class="wellness-side-note" aria-hidden="true">a slower state of mind</span></div>
    </section>
    <section class="dining section-pad" id="dining" aria-labelledby="dining-title">
      <div class="section-marker"><span>04 — THE MEDITERRANEAN TABLE</span><span>FROM THE ISLAND. WITH LOVE.</span></div>
      <div class="dining-heading"><h2 class="display reveal" id="dining-title">Taste the<br /><em>life here.</em></h2><p class="section-intro">A long lunch.<br />A table in the sun.<br />The pleasure of staying a little longer.</p></div>
      <div class="dining-composition"><figure class="dining-table reveal-image"><Photo image="dining" alt="Sunlight on a linen table with blue patterned ceramics in Spain; illustrative dining photography" /><figcaption>AN INVITATION TO LINGER · ILLUSTRATIVE DINING</figcaption></figure><div class="dining-editorial"><figure class="dining-food reveal-image"><Photo image="food" alt="Thoughtfully plated seafood; illustrative cuisine, not a Six Senses dish" sizes="(max-width:700px) 70vw, 30vw" /></figure><div class="dining-copy"><span class="eyebrow">SEASONAL BY NATURE</span><p>Produce from Can Tanca and ingredients from local growers and fishers connect the table to the landscape. At Partal, Spanish flavors meet North African influences. At The Orchard, the evening takes an Italian turn.</p><a class="text-link" href={`${official}dining/`} target="_blank" rel="noopener noreferrer">Pull up a chair</a></div></div></div>
      <div class="dining-venues"><span>PARTAL <i>Spanish & North African</i></span><span>THE ORCHARD <i>Italian evenings</i></span><span>THE FARMERS’ MARKET <i>Balearic mornings</i></span></div>
    </section>
    <section class="experiences section-pad" id="experiences" aria-labelledby="experience-title">
      <div class="section-marker"><span>05 — BEYOND THE ORDINARY</span><span>FOLLOW YOUR CURIOSITY</span></div>
      <div class="experience-heading"><h2 class="display reveal" id="experience-title">The days are yours.<br /><em>Make them extraordinary.</em></h2></div>
      <div class="experience-layout"><div class="experience-photo"><Photo image="kayak" alt="A paddleboarder on sunlit Mediterranean water; illustrative coastal photography" sizes="(max-width:700px) 100vw, 65vw" /><span class="experience-photo-count">01 / 03</span></div><div class="experience-editorial"><div class="experience-tabs" role="tablist" aria-orientation="vertical" aria-label="Island experiences"><button role="tab" id="exp-tab-0" aria-controls="experience-panel" aria-selected="true" data-experience="0"><span>01</span> Into the blue</button><button role="tab" id="exp-tab-1" aria-controls="experience-panel" aria-selected="false" tabindex="-1" data-experience="1"><span>02</span> The last light</button><button role="tab" id="exp-tab-2" aria-controls="experience-panel" aria-selected="false" tabindex="-1" data-experience="2"><span>03</span> Island rituals</button></div><div class="experience-details" role="tabpanel" id="experience-panel" aria-labelledby="exp-tab-0" tabindex="0"><span class="eyebrow" id="experience-category">COASTAL EXPLORATION</span><p id="experience-description">Explore hidden caves and sheltered bays on the resort’s guided kayak sunset tour. The northern coast, from a different perspective.</p><a class="text-link" id="experience-link" href={`${official}experiences/watersport-tour/`} target="_blank" rel="noopener noreferrer">Explore the experience</a></div><span class="experience-note">ILLUSTRATIVE DESTINATION PHOTOGRAPHY</span></div></div>
    </section>
    <section class="nature section-pad" aria-labelledby="nature-title"><div class="section-marker"><span>06 — A CONSIDERED WAY OF LIVING</span><span>CARE BEGINS HERE</span></div><div class="nature-layout"><figure class="nature-image reveal-image"><Photo image="olive" alt="An olive branch lit by Mediterranean sunlight; nature study photographed in Türkiye" /><figcaption>A MEDITERRANEAN NATURE STUDY</figcaption></figure><div class="nature-copy"><span class="eyebrow">ROOTED IN SOMETHING REAL</span><h2 class="display reveal" id="nature-title">In harmony<br /><em>with nature.</em></h2><p>Care for the island begins close to home. Earth Lab and the Can Tanca Learning Center connect guests with practical ideas for a more thoughtful way of living.</p><div class="nature-principles"><span>Learn at Earth Lab</span><span>Reconnect with the land at Can Tanca</span><span>Discover resourceful living in a Zero Waste Workshop</span></div><a class="text-link" href={`${official}sustainability/`} target="_blank" rel="noopener noreferrer">A philosophy in practice</a></div></div><p class="nature-statement reveal">A beautiful place.<br /><em>A responsibility to care for it.</em></p></section>
    <section class="gallery section-pad" id="gallery" aria-labelledby="gallery-title"><div class="section-marker"><span>07 — THE VISUAL JOURNAL</span><span>A FEW MOMENTS, HELD STILL</span></div><div class="gallery-heading"><h2 class="display reveal" id="gallery-title">Wish you<br /><em>were here.</em></h2><div class="gallery-navigation"><span>A MEDITERRANEAN PHOTO ESSAY</span><div class="gallery-controls"><button aria-label="Previous gallery images" data-gallery-scroll="-1">Previous</button><button aria-label="Next gallery images" data-gallery-scroll="1">Next</button></div></div></div><div class="gallery-track">{gallery.map((item,i) => <button class:list={['gallery-item',`gallery-item-${i}`]} data-gallery-index={i} aria-label={`View image: ${item.caption}`}><div class="gallery-image"><Photo image={item.image} alt={item.caption} sizes="(max-width:700px) 85vw, 45vw" /></div><span class="gallery-caption"><i>0{i+1}</i><span>{item.caption}<small>{item.location}</small></span></span></button>)}</div><p class="gallery-disclosure">A licensed photographic mood study. Images illustrate the Mediterranean atmosphere and do not identify Six Senses Ibiza’s rooms or facilities. <a href={`${base}credits/`}>Photography & sources</a></p></section>
    <section class="reservation section-pad" id="reservation" aria-labelledby="reservation-title"><div class="section-marker"><span>08 — YOUR NEXT CHAPTER</span><span>MAKE A LITTLE SPACE FOR YOURSELF</span></div><div class="reservation-heading"><span class="eyebrow">THE WORLD CAN WAIT.</span><h2 class="display reveal" id="reservation-title">Stay a little.<br /><em>Feel a little more.</em></h2><Sun /></div><div class="reservation-planner"><div class="planner-intro"><span class="eyebrow">IMAGINE YOUR STAY</span><p>Every good journey<br />begins with <em>a little possibility.</em></p><span class="demo-label">RESERVATION DEMONSTRATION</span></div><div class="planner-fields"><form id="booking-form" class="booking-form"><div class="booking-field"><label for="checkin">CHECK-IN</label><input type="date" id="checkin" name="checkin" required /></div><div class="booking-field"><label for="checkout">CHECK-OUT</label><input type="date" id="checkout" name="checkout" required /></div><div class="booking-field"><label for="guests">GUESTS</label><select id="guests" name="guests" aria-describedby="guest-capacity">{Array.from({length:10},(_,i)=><option value={i+1} selected={i===1}>{i+1} {i===0?'guest':'guests'}</option>)}</select></div><div class="booking-field"><label for="accommodation">ACCOMMODATION PREFERENCE</label><select id="accommodation" name="accommodation"><option>Let me discover</option>{rooms.map(room=><option data-max-guests={room.maxGuests}>{room.name}</option>)}</select></div><button class="booking-submit" type="submit" disabled>Book Your Stay</button></form><noscript><p class="booking-notice">Use the official reservations link below to book directly.</p></noscript><p class="booking-notice" id="guest-capacity" aria-live="polite"></p><p class="booking-notice">Demonstration only. No live availability, rates, or reservations. Review your plan, then continue to the official website.</p></div></div><div class="booking-summary" id="booking-summary" hidden tabindex="-1" aria-live="polite"><span class="eyebrow">YOUR STAY, IMAGINED</span><h3>A little closer to being here.</h3><p id="booking-plan"></p><p>No reservation has been made. Check availability and complete your booking with Six Senses. Please re-enter your preferences on their website.</p><a class="button button-dark" href={`${official}accommodation/`} target="_blank" rel="noopener noreferrer">Continue to official booking</a></div><a class="official-booking-link" href={`${official}accommodation/`} target="_blank" rel="noopener noreferrer">Go directly to official Six Senses reservations</a></section>
  </main>
  <footer class="footer section-pad"><div class="footer-top"><a href="#" class="footer-wordmark">six senses <em>ibiza.</em></a><a href="#" class="back-top">Back to the beginning</a></div><div class="footer-bottom"><p>Independent Portfolio Concept — Not affiliated with Six Senses.<br /><span>A design & frontend study by Filip Nedelkoski.</span></p><div><a href={`${base}credits/`}>Photography & sources</a><a href={official} target="_blank" rel="noopener noreferrer">Official resort website</a></div><span>© {new Date().getFullYear()} / THE BEAUTY OF BEING.</span></div></footer>
  <PhotoLightbox imageBase={`${base}images/`} client:load />
</Layout>
